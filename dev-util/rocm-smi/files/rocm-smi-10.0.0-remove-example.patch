Do not build the example; unused, and only generates QA warnings.

Regenerated from rocm-smi-5.7.1-remove-example.patch for ROCm 10.0. The
example target survives verbatim at 10.0 -- rocm_smi/CMakeLists.txt still sets
SMI_EXAMPLE_EXE, builds example/rocm_smi_example.cc and links it -- but the
surrounding lines moved (add_library is now one line, target_link_libraries
gained PRIVATE and dl), so the 5.7.1 hunk no longer applied.

WITH_EXAMPLE is never set by the ebuild, so the executable is simply not built.
It was never installed either way; this just avoids compiling it.
--- a/rocm_smi/CMakeLists.txt
+++ b/rocm_smi/CMakeLists.txt
@@ -79,8 +79,10 @@
 
 set(SMI_EXAMPLE_EXE "rocm_smi_ex")
 
+if (WITH_EXAMPLE)
 add_executable(${SMI_EXAMPLE_EXE} "example/rocm_smi_example.cc")
 target_link_libraries(${SMI_EXAMPLE_EXE} ${ROCM_SMI_TARGET})
+endif()
 add_library(${ROCM_SMI_TARGET} ${CMN_SRC_LIST} ${SMI_SRC_LIST} ${CMN_INC_LIST} ${SMI_INC_LIST})
 target_link_libraries(${ROCM_SMI_TARGET} PRIVATE pthread rt dl)
 target_include_directories(
