# Local revivals for sci-physics/mantid, which retains an optional Qt5
# build beside its default Qt6 build. Drop these revivals once mantid
# removes IUSE=qt5.
#
# dev-qt/qthelp:5: ::gentoo last-rited 2026-02-27, removed 2026-03-29
# ("obsolete Qt5 non-qtbase modules without revdeps"). Revived in this
# overlay at dev-qt/qthelp-5.15.19.
dev-qt/qthelp:5
# ::gentoo masked the entire dev-qt slot:5 set on 2026-05-15 (bug
# #948836) for removal on 2026-06-30. This overlay continues the slot
# at v5.15.19-lts-lgpl with KDE Qt5 Patch Collection applied via the
# qt5-build.eclass. The mask uses bare ":5" so it catches our 5.15.19
# ebuilds too; unmask the whole set so users on this overlay can
# install/upgrade.

# qtbase split set (gentoo bug #948836)
dev-qt/qtconcurrent:5
dev-qt/qtcore:5
dev-qt/qtdbus:5
dev-qt/qtgui:5
dev-qt/qtnetwork:5
dev-qt/qtopengl:5
dev-qt/qtprintsupport:5
dev-qt/qtsql:5
dev-qt/qttest:5
dev-qt/qtwidgets:5
dev-qt/qtxml:5

# Non-qtbase qt5 modules (gentoo bugs #948836, #964253)
dev-qt/linguist-tools:5
dev-qt/qtdeclarative:5
dev-qt/qtgraphicaleffects:5
dev-qt/qtmultimedia:5
dev-qt/qtquickcontrols:5
dev-qt/qtquickcontrols2:5
dev-qt/qtsvg:5
dev-qt/qttranslations:5
dev-qt/qtwayland:5
dev-qt/qtx11extras:5

# qtwebchannel:5 — ::gentoo removed its :5 slot outright (now ships only
# :6), so no ::gentoo mask currently catches our ebuild, unlike the set
# above. Unmasked here for consistency with the revived
# dev-qt/qtwebchannel-5.15.19 (cf. dev-qt/qthelp:5 at top).
dev-qt/qtwebchannel:5

# TeX Live 2026. ::gentoo masked its TL2026 for testing on 2026-10-02
# (profiles/package.mask) with atoms that name no repository, so the mask
# also hides this overlay's own TL2026 set, a newer snapshot carried here
# since 2026-05-28. Portage applies a repository's package.unmask to that
# repository's packages only, so ::gentoo's TL2026 stays masked. The
# newer dev-tex/{biber,biblatex,glossaries,latex2pydata,minted} that the
# same mask covers stay masked here; unmasking them is a separate call.
# ::gentoo's dvipsk entry reads app-test/dvipsk and matches nothing;
# ours is listed so a corrected entry does not hide it. Drop this block
# once ::gentoo lifts its mask. verified 2026-10-03
