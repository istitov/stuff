# Ivan S. Titov <iohann.s.titov@gmail.com> (2026-04-20)
# IPX was removed from the Linux kernel in 4.18 (2018). Userspace utils
# are only useful with the out-of-tree ipx module. Keep but mask.
net-misc/ipx-utils

# Ivan S. Titov <iohann.s.titov@gmail.com> (2026-04-20)
# Upstream (github.com/megabaks) dormant since 2014-02. No tagged
# release, 9999-only. Keep but mask.
app-portage/portopts

# Ivan S. Titov <iohann.s.titov@gmail.com> (2026-04-22)
# ::gentoo qscintilla-2.14.1-r2 dropped Qt5 support; only -r1, revived in
# this overlay, still builds libqscintilla2_qt5. sci-physics/mantid keeps a
# qt5 USE flag beside the default qt6 one, and mantid[qt5] needs that
# library, so the trigger for lifting this mask is mantid losing IUSE=qt5 -
# not mantid defaulting to qt6, which already happened at 6.16.1.1.
# re-verified 2026-07-28
=x11-libs/qscintilla-2.14.1-r2

# Ivan S. Titov <iohann.s.titov@gmail.com> (2026-06-08)
# Last of the 1.x series before the 2.0 rewrite; retained as a recovery
# ebuild but blocked from default install. Remove this mask if a 1.x
# rollback becomes relevant again.
=app-portage/portconf-1.6.8

# Ivan S. Titov <iohann.s.titov@gmail.com> (2026-08-23)
# Beta desktop UI (Tauri). This -bin ships only the GUI shell; on first
# launch unsloth-studio downloads its own uv, a private CPython, PyTorch and
# the inference engine into ~/.unsloth/studio, entirely outside portage - it
# does not use the system sci-ml/unsloth / sci-ml/pytorch stack. Masked so
# users opt in to that runtime self-bootstrap (and the beta status)
# consciously. Lift once a version reuses system packages, or drop the beta tag.
sci-ml/unsloth-desktop-bin
