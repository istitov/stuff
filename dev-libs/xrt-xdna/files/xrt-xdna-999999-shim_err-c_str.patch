   if (!ofs.is_open())
-    shim_err(errno, "Failed to open dump file: %s", dumpfile);
+    shim_err(errno, "Failed to open dump file: %s", dumpfile.c_str());
 
   for (size_t i = 0; i < size; i++)
     ofs.write(reinterpret_cast<char *>(buf) + i, 1);
@@ -42,7 +42,7 @@
