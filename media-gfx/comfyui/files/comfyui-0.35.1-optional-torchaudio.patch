From: Gentoo ComfyUI maintainers
Subject: [PATCH] make torchaudio optional for non-audio workflows

Image-only startup imports torchaudio from core modules and mixed video/audio
node modules.  Defer failures until audio paths are used so USE=-audio retains
the non-audio nodes.

--- a/comfy/ldm/lightricks/vae/audio_vae.py
+++ b/comfy/ldm/lightricks/vae/audio_vae.py
@@ -1,7 +1,10 @@
 import json
 from dataclasses import dataclass
 import torch
-import torchaudio
+try:
+    import torchaudio
+except ImportError:
+    torchaudio = None

 from comfy.ldm.mmaudio.vae.distributions import DiagonalGaussianDistribution
 from comfy.ldm.lightricks.symmetric_patchifier import AudioPatchifier
@@ -51,11 +54,15 @@ class AudioPreprocessor:
