	[hayro]='https://github.com/LaurenzV/hayro;56c62b2a25232d5407af8efe819c49ad46605979;hayro-%commit%/hayro'
)

RUST_MIN_VER="1.92"

inherit cargo gnome2-utils meson xdg

DESCRIPTION="Sketch and take handwritten notes"
HOMEPAGE="
	https://rnote.flxzt.net/
	https://github.com/flxzt/rnote
"
SRC_URI="
	https://github.com/flxzt/rnote/archive/refs/tags/v${PV}.tar.gz -> ${P}.tar.gz
	${CARGO_CRATE_URIS}
"

LICENSE="GPL-3+"
# Dependent crate licenses
LICENSE+="
	Apache-2.0 Apache-2.0-with-LLVM-exceptions BSD-2 BSD CC0-1.0 ISC
	LGPL-2.1+ MIT MPL-2.0 UoI-NCSA Unicode-3.0 ZLIB
"
# Bundled fonts (OFL-1.1) and sound samples (CC0-1.0, CC-BY-3.0)
LICENSE+=" OFL-1.1 CC-BY-3.0"
SLOT="0"
KEYWORDS="~amd64"

# The librsvg crate is compiled into the binaries instead of linking
# gnome-base/librsvg. Its pkg-config checks also want the font stack and
# gdk-pixbuf, which only DEPEND carries: none of them is in DT_NEEDED.
# rodio playback links alsa-lib through cpal. verified 2026-09-22
RDEPEND="
	>=dev-libs/glib-2.76:2
	dev-libs/libxml2:2=
	>=gui-libs/gtk-4.18:4
	>=gui-libs/libadwaita-1.7:1
	media-libs/alsa-lib
	media-libs/graphene
	>=x11-libs/cairo-1.18[glib]
	>=x11-libs/pango-1.50
	virtual/libintl
"
DEPEND="
	${RDEPEND}
	dev-libs/appstream
	media-libs/fontconfig
	media-libs/freetype:2
	media-libs/harfbuzz
	x11-libs/gdk-pixbuf:2
"
# cmake is a required program in meson.build, though no crate uses it.
BDEPEND="
	dev-build/cmake
	dev-libs/glib:2
	dev-util/glib-utils
	sys-devel/gettext
	virtual/pkgconfig
"

src_configure() {
	meson_src_configure
	# meson.build points cargo at its own CARGO_HOME; route it to the
	# eclass config so the vendored crates are used offline.
	ln -s "${CARGO_HOME}" "${BUILD_DIR}/cargo-home" || die
}

src_compile() {
	cargo_env meson_src_compile
}

src_install() {
	cargo_env meson_src_install
}

src_test() {
	cargo_env meson_src_test
}

# Upstream's post-install script refreshes the font cache for the bundled
# fonts, but skips it whenever DESTDIR is set.
rnote_fontcache_update() {
	if [[ -z ${ROOT} ]] && has_version media-libs/fontconfig; then
		fc-cache -fs || ewarn "fc-cache failed"
	fi
}

pkg_postinst() {
	xdg_pkg_postinst
	gnome2_schemas_update
	rnote_fontcache_update
}

pkg_postrm() {
	xdg_pkg_postrm
	gnome2_schemas_update
	rnote_fontcache_update
}
