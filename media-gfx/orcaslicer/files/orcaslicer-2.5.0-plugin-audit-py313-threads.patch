From: stuff overlay maintainer
Subject: Audit and attribute plugin threads on Python 3.13+

The plugin sandbox only knows 3.12's thread entry point. Python 3.13
added _thread.start_joinable_thread, which threading.Thread.start()
calls instead (cached as threading._start_joinable_thread), and which
raises its own audit event. On 3.13+ a plugin could therefore start
threads without the Threading grant, and those threads ran outside the
plugin's audit scope.

Map _thread.start_joinable_thread to the Threading category, wrap it
with the same attribution shim as start_new_thread, and make the
thread test expect the event the running interpreter raises.
# verified 2026-11-07

diff --git a/src/slic3r/plugin/PluginAuditManager.cpp b/src/slic3r/plugin/PluginAuditManager.cpp
index b90e7e54..1c4e9a21 100644
--- a/src/slic3r/plugin/PluginAuditManager.cpp
+++ b/src/slic3r/plugin/PluginAuditManager.cpp
@@ -132,6 +132,8 @@ static const std::unordered_map<std::string, AuditEventCategory> audit_event_cat
 
     // threading
     {"_thread.start_new_thread", AuditEventCategory::Threading},
+    // Python 3.13+: threading.Thread.start() goes through start_joinable_thread instead.
+    {"_thread.start_joinable_thread", AuditEventCategory::Threading},
     // processreplace: exec* replaces the current process image rather than spawning a child
     {"os.exec", AuditEventCategory::ProcessReplace},
 };
diff --git a/src/slic3r/plugin/PythonPluginBridge.cpp b/src/slic3r/plugin/PythonPluginBridge.cpp
index b27a8b14..40431b25 100644
--- a/src/slic3r/plugin/PythonPluginBridge.cpp
+++ b/src/slic3r/plugin/PythonPluginBridge.cpp
@@ -756,6 +756,50 @@ void install_python_thread_audit_shim()
             }
         }
 
+        // Python 3.13 added _thread.start_joinable_thread, which threading.Thread.start() calls
+        // instead (cached as threading._start_joinable_thread). Wrap it the same way, or threads
+        // started through threading run outside the plugin's audit scope.
+        py::object joinable = py::reinterpret_steal<py::object>(
+            PyObject_GetAttrString(thread_module.ptr(), "start_joinable_thread"));
+        if (!joinable) {
+            PyErr_Clear();
+        } else if (PyCallable_Check(joinable.ptr())) {
+            py::object joinable_shim = py::cpp_function(
+                [joinable](py::object function, py::object handle, py::object daemon) -> py::object {
+                    const std::string plugin_key = PluginAuditManager::instance().current_plugin();
+                    if (plugin_key.empty())
+                        return joinable(function, py::arg("handle") = handle, py::arg("daemon") = daemon);
+                    const std::string capability = PluginAuditManager::instance().current_capability();
+
+                    py::object guarded = py::cpp_function(
+                        [function, plugin_key, capability](py::args call_args, py::kwargs call_kwargs) -> py::object {
+                            ScopedPluginAuditContext audit_scope(plugin_key, capability);
+                            PyObject* result = PyObject_Call(function.ptr(), call_args.ptr(), call_kwargs.ptr());
+                            if (result == nullptr)
+                                throw py::error_already_set();
+                            return py::reinterpret_steal<py::object>(result);
+                        });
+                    return joinable(guarded, py::arg("handle") = handle, py::arg("daemon") = daemon);
+                },
+                py::arg("function"), py::arg("handle") = py::none(), py::arg("daemon") = true);
+
+            if (PyObject_SetAttrString(thread_module.ptr(), "start_joinable_thread", joinable_shim.ptr()) < 0) {
+                PyErr_Clear();
+                BOOST_LOG_TRIVIAL(error)
+                    << "[AUDIT] Failed to install Python thread attribution shim on _thread.start_joinable_thread";
+            } else if (threading_module && threading_module != Py_None) {
+                const int has_cached = PyObject_HasAttrString(threading_module, "_start_joinable_thread");
+                if (has_cached < 0)
+                    PyErr_Clear();
+                else if (has_cached == 1
+                         && PyObject_SetAttrString(threading_module, "_start_joinable_thread", joinable_shim.ptr()) < 0) {
+                    PyErr_Clear();
+                    BOOST_LOG_TRIVIAL(warning)
+                        << "[AUDIT] Failed to update threading._start_joinable_thread with the Python thread attribution shim";
+                }
+            }
+        }
+
         BOOST_LOG_TRIVIAL(info) << "[AUDIT] Python thread attribution shim installed";
     } catch (const std::exception& ex) {
         BOOST_LOG_TRIVIAL(error) << "[AUDIT] Failed to install Python thread attribution shim: " << ex.what();
