Subject: [PATCH] tests: use boost::filesystem::copy_options

Boost.Filesystem 1.85 removed the deprecated copy_option enum; the
copy_options spelling has existed since 1.74. verified 2026-11-07

diff --git a/tests/libslic3r/test_vendor_cache.cpp b/tests/libslic3r/test_vendor_cache.cpp
index ee590f82..e38356ba 100644
--- a/tests/libslic3r/test_vendor_cache.cpp
+++ b/tests/libslic3r/test_vendor_cache.cpp
@@ -1656,7 +1656,7 @@ TEST_CASE("a cache that fails mid-body deserialization is rejected and leaves th
     size_t truncate_by = 40;
     bool   throws      = false;
     for (; truncate_by <= 200; truncate_by += 8) {
-        fs::copy_file(valid_cache, corrupt_cache, fs::copy_option::overwrite_if_exists);
+        fs::copy_file(valid_cache, corrupt_cache, fs::copy_options::overwrite_existing);
         truncate_payload_and_fix_header(corrupt_cache.string(), truncate_by);
         PresetBundle probe_bundle;
         if (!probe_bundle.load_vendor_cache(corrupt_cache.string(), vid, Semver("1.0.0"))) {
