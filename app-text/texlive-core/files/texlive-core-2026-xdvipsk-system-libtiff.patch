+/**
+Open a TIFF stream for reading or writing through the BitmapIO callbacks.
+The system libtiff keeps its own TIFFFdOpen and memory routines, so this
+uses a private name and installs the silent handlers through the public API.
+@param handle File handle
+@param name Name of the file handle
+@param mode Specifies if the file is to be opened for reading ("r") or writing ("w")
+*/
+static TIFF *
+bitmapTIFFOpen(thandle_t handle, const char *name, const char *mode) {
+	TIFF *tif;
+	
+	TIFFSetWarningHandler(msdosWarningHandler);
+	TIFFSetErrorHandler(msdosErrorHandler);
+
+	// Open the file; the callback will set everything up
+	tif = TIFFClientOpen(name, mode, handle,
+	    _tiffReadProc, _tiffWriteProc, _tiffSeekProc, _tiffCloseProc,
+	    _tiffSizeProc, _tiffMapProc, _tiffUnmapProc);
+
+	return tif;
+}
 
