+def system_runtime() -> bool:
+    """Gentoo system install (sci-ml/unsloth[studio], UNSLOTH_STUDIO_SYSTEM=1)."""
+    return os.environ.get("UNSLOTH_STUDIO_SYSTEM") == "1"
+
+
+def system_default_flm() -> bool:
+    """Whether the packaged FastFlowLM stands in for an unset UNSLOTH_FLM_NPU_BIN."""
+    return system_runtime() and not os.environ.get(FLM_BINARY_ENV, "").strip()
+
+
 def local_flm_binary() -> Optional[Path]:
     value = os.environ.get(FLM_BINARY_ENV, "").strip()
+    if not value and system_runtime():
+        # The real binary, not the /usr/bin/flm wrapper: Studio finds FastFlowLM's
+        # model_list.json at <prefix>/share/flm relative to it. UNSLOTH_STUDIO_FLM
+        # is the override earlier Gentoo builds read.
+        value = os.environ.get("UNSLOTH_STUDIO_FLM", "/opt/fastflowlm/bin/flm")
     return Path(value) if value else None
 
 
