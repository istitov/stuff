+# Gentoo system install (sci-ml/unsloth[studio]): UNSLOTH_STUDIO_SYSTEM=1 runs
+# the packaged sci-ml/lemonade and sci-ml/fastflowlm instead of downloading
+# Lemonade's Ubuntu build and the FastFlowLM release it fetches in turn.
+def system_runtime() -> bool:
+    return os.environ.get("UNSLOTH_STUDIO_SYSTEM") == "1"
+
+
+def system_lemond() -> Path:
+    return Path(os.environ.get("UNSLOTH_STUDIO_LEMOND", "/usr/bin/lemond"))
+
+
+def system_flm() -> Path:
+    # The real binary, not the /usr/bin/flm wrapper: Studio finds FastFlowLM's
+    # model_list.json at <prefix>/share/flm relative to it.
+    return Path(os.environ.get("UNSLOTH_STUDIO_FLM", "/opt/fastflowlm/bin/flm"))
+
+
