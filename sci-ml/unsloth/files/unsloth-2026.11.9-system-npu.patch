+@functools.lru_cache(maxsize = 4)
+def _system_lemond_version(lemond: str, mtime_ns: int, size: int) -> Optional[str]:
+    """Run once per binary, as status reads would otherwise spawn lemond each time."""
+    try:
+        completed = subprocess.run(
