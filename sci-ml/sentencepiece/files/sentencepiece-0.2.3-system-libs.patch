-    cflags, libs = get_cflags_and_libs('../build')
-    abseil_libs = find_abseil_lib('../build')
+    if is_sentencepiece_installed():
+      # Link the shared sentencepiece found through pkg-config; its Cflags
+      # cover the generated headers, and the source tree supplies the rest.
+      cflags = (['-std=c++20'] + get_build_includes('../build', is_msvc=False)
+                + run_pkg_config('cflags', SYSTEM_PC_MODULES))
+      libs = run_pkg_config('libs', SYSTEM_PC_MODULES)
+      abseil_libs = []
+    else:
+      cflags, libs = get_cflags_and_libs('../build')
+      abseil_libs = find_abseil_lib('../build')
 
     if len(libs) == 0:
