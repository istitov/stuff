Use system http-parser, libutf8proc and zxcvbn-c in the bundled SDK.

sdk/third_party carries copies of http-parser 2.6.0, utf8proc 2.1.0 and
zxcvbn-c. Link the system libraries instead and include their headers
from the top-level include directory, where Gentoo installs them.

diff --git a/sdk/cmake/modules/sdklib_libraries.cmake b/sdk/cmake/modules/sdklib_libraries.cmake
index e51fb8e..f8b3868 100644
--- a/sdk/cmake/modules/sdklib_libraries.cmake
+++ b/sdk/cmake/modules/sdklib_libraries.cmake
@@ -9,9 +9,11 @@ macro(load_sdklib_libraries)
     if(NOT HAVE_GLOB_H AND NOT WIN32)
         target_link_libraries(SDKlib PUBLIC glob)
     endif()
-    target_link_libraries(SDKlib PUBLIC http_parser)
-    target_link_libraries(SDKlib PUBLIC utf8proc)
-    target_link_libraries(SDKlib PUBLIC zxcvbn-c)
+    # Gentoo: system net-libs/http-parser, dev-libs/libutf8proc and
+    # dev-libs/zxcvbn-c instead of the copies in third_party/.
+    find_package(PkgConfig REQUIRED)
+    pkg_check_modules(utf8proc REQUIRED IMPORTED_TARGET libutf8proc)
+    target_link_libraries(SDKlib PUBLIC http_parser PkgConfig::utf8proc zxcvbn)
 
     if(VCPKG_ROOT)
         find_package(cryptopp CONFIG REQUIRED)
