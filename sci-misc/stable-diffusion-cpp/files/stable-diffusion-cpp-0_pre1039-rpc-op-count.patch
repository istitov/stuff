The ggml fork moved its four sd.cpp-specific operators (QUANTIZE_I8_CONVROT,
SAGE_ATTN, SOL_ATTN, ROPE_APPLY) out to backend extensions, which brings
GGML_OP_COUNT from 105 to 101, but left the RPC header's guard alone, so
GGML_RPC=ON fails to compile. Update the count and, as the guard asks, the
protocol patch version.

--- a/ggml/include/ggml-rpc.h
+++ b/ggml/include/ggml-rpc.h
@@ -8,10 +8,10 @@
 
 #define RPC_PROTO_MAJOR_VERSION    8
 #define RPC_PROTO_MINOR_VERSION    0
-#define RPC_PROTO_PATCH_VERSION 3
+#define RPC_PROTO_PATCH_VERSION 4
 
 #ifdef  __cplusplus
-static_assert(GGML_OP_COUNT == 105, "GGML_OP_COUNT has changed - update RPC_PROTO_PATCH_VERSION");
+static_assert(GGML_OP_COUNT == 101, "GGML_OP_COUNT has changed - update RPC_PROTO_PATCH_VERSION");
 #endif
 
 #define GGML_RPC_MAX_SERVERS       16
