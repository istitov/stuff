Normally, MIOpen compiles tests during test phase instead of "compile".
This patch allows to build testing executables during compile phase.

Regenerated from miopen-6.1.1-build-all-tests.patch for ROCm 10.0 (verified
2026-08-30): the add_executable line survives verbatim but moved from 330 to
392, with a new comment and a cmake-lint directive around it, so the old hunk
no longer applied. Behaviour is unchanged.
--- a/test/CMakeLists.txt
+++ b/test/CMakeLists.txt
@@ -389,7 +389,7 @@
 # Build a test executable, wire up its libraries, and register it with ctest.
 function(add_test_executable TEST_NAME)
     # cmake-lint: disable=R0912
-    add_executable (${TEST_NAME} EXCLUDE_FROM_ALL ${ARGN})
+    add_executable (${TEST_NAME} ${ARGN})
     if(WIN32)
         target_compile_definitions(${TEST_NAME} PRIVATE NOMINMAX)
     endif()
